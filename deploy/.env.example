# ST Crucible 单机自托管环境变量示例
# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，切勿提交真实凭据。

# 发布端口（默认仅本机回环访问网关；web 端口按需调整）
WEB_PORT=8080
GATEWAY_PORT=127.0.0.1:3001

# 服务版本（写入 health 响应）
SERVICE_VERSION=0.1.0

# solver-worker 心跳间隔（秒）
HEARTBEAT_SECONDS=5

# PostgreSQL（本地开发默认值；生产部署务必修改密码）
POSTGRES_DB=st_crucible
POSTGRES_USER=st
POSTGRES_PASSWORD=st_local_dev_only
