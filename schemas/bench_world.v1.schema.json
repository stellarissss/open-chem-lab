{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellarissss.github.io/open-chem-lab/schemas/bench_world.v1.schema.json",
  "title": "BenchWorld",
  "description": "st.bench_world.v1 — 自由写实台面的世界状态（008）：器材实例/位置/倾角/容器内容。前端权威、网关与求解侧按需订阅。器材与试剂瓶统一为可摆放容器实例；一切数值由操作与求解产生、无预设配比。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bench_id", "apparatus_instances", "bench_bounds", "ruleset_version"],
  "properties": {
    "schema_version": { "const": "st.bench_world.v1" },
    "bench_id": { "type": "string", "minLength": 1, "description": "台面唯一 ID（单机单台面，预留多实例）" },
    "apparatus_instances": {
      "type": "array",
      "description": "台上所有器材实例（含试剂瓶，统一为可摆放容器）",
      "items": { "$ref": "#/$defs/ApparatusInstance" }
    },
    "bench_bounds": { "$ref": "#/$defs/BenchBounds" },
    "ruleset_version": { "type": "string", "minLength": 1, "description": "本台面对应的物化 ruleset 版本（事实层对齐）" }
  },
  "$defs": {
    "BenchBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_mm", "height_mm"],
      "description": "台面物理边界（真实尺度 mm）；摆放与重叠判定用。渲染按比例换算 px。",
      "properties": {
        "width_mm": { "type": "number", "exclusiveMinimum": 0, "description": "台面宽 mm" },
        "height_mm": { "type": "number", "exclusiveMinimum": 0, "description": "台面高 mm（纵深投影）" }
      }
    },
    "ApparatusInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "apparatus_id", "position_mm", "rotation_deg", "contents"],
      "description": "一件台上器材实例。试剂瓶以 apparatus_id 指向瓶器材卡、contents 装瓶装溶液；倾角由玩家指针方位角操作产生。",
      "properties": {
        "instance_id": { "type": "string", "minLength": 1, "description": "实例唯一 ID（如 beaker-3）" },
        "apparatus_id": { "type": "string", "minLength": 1, "description": "器材卡 ID，指向 apparatus 事实源" },
        "position_mm": { "$ref": "#/$defs/Position" },
        "rotation_deg": { "type": "number", "description": "容器倾角（度，绕容器中心；玩家操作产生，液面世界水平由表现层反向抵消）" },
        "contents": {
          "type": "array",
          "description": "容器内物质（倾倒追加，体积由操作产生）",
          "items": { "$ref": "#/$defs/SubstanceContent" }
        },
        "reagent_compound_id": {
          "type": "string",
          "description": "若为试剂瓶，指向瓶中溶液的 compound_id（浓度取该卡 reagent_solution）"
        }
      }
    },
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "description": "台面坐标（mm，原点左上角）",
      "properties": {
        "x": { "type": "number", "description": "横坐标 mm" },
        "y": { "type": "number", "description": "纵坐标 mm" }
      }
    },
    "SubstanceContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compound_id", "concentration_mol_L", "volume_L"],
      "description": "容器内一份物质：物质 ID + 浓度（试剂瓶标签初始条件）+ 体积（操作产生）",
      "properties": {
        "compound_id": { "type": "string", "minLength": 1, "description": "引用 content 真实物质 ID" },
        "concentration_mol_L": { "type": "number", "exclusiveMinimum": 0, "description": "浓度 mol/L（来自试剂瓶标签或稀释归一，非硬编码）" },
        "volume_L": { "type": "number", "exclusiveMinimum": 0, "description": "本次加入/当前体积 L（由倾倒操作产生）" }
      }
    }
  }
}
