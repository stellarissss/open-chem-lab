{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellarissss.github.io/open-chem-lab/schemas/solution_speciation.v1.schema.json",
  "title": "SolutionSpeciation",
  "description": "每容器隐藏化学态：不可见反应也真实发生。物种分布 + pH + 离子强度 + 平衡 + 隐藏反应。由求解层（spec-003+）产出，本切片只定义契约。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "speciation_id", "container_id", "species", "ph", "ionic_strength", "ruleset_version"],
  "properties": {
    "schema_version": { "const": "st.solution_speciation.v1" },
    "speciation_id": { "type": "string", "minLength": 1, "description": "快照唯一 ID，供幂等与回放" },
    "container_id": { "type": "string", "minLength": 1, "description": "对应实验台容器摆位 ID" },
    "species": {
      "type": "array",
      "description": "物种分布（浓度/活度/摩尔分数）",
      "items": { "$ref": "#/$defs/SpeciesConcentration" }
    },
    "ph": { "type": "number", "description": "pH 值（求解结果）" },
    "outcome": {
      "$ref": "#/$defs/SolveOutcome",
      "default": "solved",
      "description": "求解出口语义：区分已求解、条件外无变化与诚实降级，避免把数值失败表述为科学结论"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "降级出口的置信度（outcome=degraded 时给出），表现层据此提示"
    },
    "reason": {
      "type": "string",
      "description": "非 solved 出口的诚实原因（如覆盖外物质、活度越界、数值不收敛）；solved 时不给出。兑现 spec-003 降级附原因的承诺"
    },
    "ionic_strength": { "type": "number", "minimum": 0, "description": "离子强度 mol/L" },
    "pe": { "type": "number", "description": "氧化还原电位 pe（可选）" },
    "temperature_K": { "type": "number", "exclusiveMinimum": 0, "default": 298.15 },
    "equilibria": {
      "type": "array",
      "description": "生效平衡引用（指向 reaction_rule ID）",
      "items": { "type": "string", "minLength": 1 }
    },
    "hidden_reactions": {
      "type": "array",
      "description": "隐藏反应（不可见但真实发生，引用 reaction_rule ID）",
      "items": { "type": "string", "minLength": 1 }
    },
    "indicators": {
      "type": "array",
      "description": "本体系实际加入的指示剂 compound_id 列表；仅对这些指示剂派生变色现象（倒什么看什么）",
      "items": { "type": "string", "minLength": 1 }
    },
    "physics_note": {
      "type": "string",
      "description": "错误操作后果的物理提示（如放热飞溅），供表现层与面板显示"
    },
    "ruleset_version": { "type": "string", "minLength": 1, "description": "求解所用规则集版本，保证可复现" },
    "timestamp_ms": { "type": "integer", "minimum": 0, "description": "相对仿真起点毫秒（时间轴对齐）" },
    "source": { "$ref": "#/$defs/Source" }
  },
  "$defs": {
    "SolveOutcome": {
      "type": "string",
      "description": "求解出口三态：solved=正常求解；no_significant_change=条件在覆盖范围外、当前条件下无明显变化（合法结论）；degraded=数值不收敛或活度模型超适用域，诚实降级并给置信度",
      "enum": ["solved", "no_significant_change", "degraded"]
    },
    "SpeciesConcentration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species_id", "concentration_mol_L"],
      "properties": {
        "species_id": { "type": "string", "minLength": 1, "description": "物种 ID（如 H+ / OH- / CH3COO-）" },
        "concentration_mol_L": { "type": "number", "minimum": 0, "description": "摩尔浓度 mol/L" },
        "activity": { "type": "number", "description": "活度（可选，求解器给出）" },
        "mole_fraction": { "type": "number", "minimum": 0, "maximum": 1, "description": "摩尔分数（可选）" }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["solver", "authoritative_db", "computed"] },
        "ref": { "type": "string", "minLength": 1, "description": "求解器/数据源标识" },
        "version": { "type": ["string", "null"] },
        "snapshot_date": { "type": ["string", "null"] }
      }
    }
  }
}
